{
  "expo": {
    "name": "BoardEase",
    "slug": "board-ease",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to help you upload images.",
          "cameraPermission": "The app accesses your camera to take photos."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fa53c25-6aba-4770-8538-deed8256d349"
      }
    },
    "owner": "hakugin"
  }
}
